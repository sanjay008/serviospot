# Enable the confirmed catering mobile OTP API.
EXPO_PUBLIC_API_ENABLED=true
EXPO_PUBLIC_API_URL=

# The catering mobile OTP API expects its verify/session token in the JSON body.
EXPO_PUBLIC_API_AUTH_MODE=body
EXPO_PUBLIC_COMPANY_LOGIN=catering

# Optional websocket override. Defaults to the API URL with an /api path removed.
EXPO_PUBLIC_SOCKET_URL=
