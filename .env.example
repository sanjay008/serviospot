# Keep API calls disabled until the backend contract and credentials are confirmed.
EXPO_PUBLIC_API_ENABLED=false
EXPO_PUBLIC_API_URL=

# Select after the backend confirms how it expects auth: body, bearer, or none.
EXPO_PUBLIC_API_AUTH_MODE=body
EXPO_PUBLIC_COMPANY_LOGIN=

# Optional websocket override. Defaults to the API URL with an /api path removed.
EXPO_PUBLIC_SOCKET_URL=
